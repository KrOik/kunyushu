<resources>
    <!-- The activity only provides a platform window; all app surfaces are Compose M3. -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/portal_surface</item>
        <item name="android:statusBarColor">@color/theme_appbar_color</item>
        <item name="android:navigationBarColor">@color/portal_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
